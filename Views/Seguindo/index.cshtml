@model ProjetoCinemanticaMVC.Models.SeguindoViewModel

@{
    Layout = null;
}

<h2>Seguindo</h2>

<div class="following-users-bar">
    @foreach (var seg in Model.Seguindo)
    {   
        <div class="user-bubble">
            <img src="@(seg.seguido.foto_perfil != null 
                ? $"data:image/png;base64,{Convert.ToBase64String(seg.seguido.foto_perfil)}" 
                : "/images/default-user.png")" />

            <span>@seg.seguido.nome</span>
        </div>
    }
</div>

<hr />

<h3>Feed</h3>
<div class="feed-container">
    @foreach (var post in Model.Feed)
    {
        <article class="review-card">
            <div class="review-header">
                <span>@post.id_usuarioNavigation.nome</span>
                <span>@post.data_postagem?.ToString("dd/MM/yyyy")</span>
            </div>

            <p>@post.tipo_comentario</p>
        </article>
    }
</div>
