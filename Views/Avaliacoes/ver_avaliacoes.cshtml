
@model List<ProjetoCinemanticaMVC.Models.ComentarioViewModel>
@{
    Layout = null;
    var fotoUsuarioPerfil = Context.Session.GetString("UsuarioFoto"); 
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cinemantica - Avaliações</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/home.css">
</head>

<body>
    <script>
        const serverLoggedIn = "@(Context.Session.GetString("UsuarioId") != null ? "true" : "false")";
        const serverUser = "@Context.Session.GetString("UsuarioNome")";

        if (serverLoggedIn === "true") {
            localStorage.setItem('isLoggedIn', 'true');
            if (serverUser) localStorage.setItem('currentUser', serverUser);
        } else {
            localStorage.removeItem('isLoggedIn');
            localStorage.removeItem('currentUser');
        }
    </script>
    <header class="main-header">
        <button class="hamburger active-button"></button>
        <a href="@Url.Action("Index", "Home")" class="barra-topo">
            <img src="~/assets/Cadastro-images/images/logo.png" alt="Logotipo Cinemantica" class="logo">
        </a>
        <nav class="main-nav">
            <div class="acoes-header">
                <div class="barra-pesquisa">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" placeholder="Busque aqui...">
                </div>
                <div class="acoes-usuario">
                    <div class="notificacao-usuario">
                        <i class="fas fa-bell action-icon"></i>
                        <div class="notification-dot"></div>
                    </div>
                    <div class="user-profile-container">
                        <div class="icone-usuario" id="user-icon">
                             <img src="@(string.IsNullOrEmpty(fotoUsuarioPerfil) 
                                                         ? "/assets/img/img-perfil.png" 
                                                         : $"data:image/*;base64,{fotoUsuarioPerfil}")" alt="Foto de Perfil" class="profile-avatar-large">
                        </div>
                        <div class="user-dropdown" id="user-dropdown">
                            <a href="@Url.Action("Index", "Login")">Fazer login</a>
                            <a href="@Url.Action("Index", "Cadastro")">Criar conta</a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="content-wrapper">
        <aside class="sidebar">
            <nav class="sidebar-nav">
                <ul>
                    <li><a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Home</a></li>
                    <li><a href="@Url.Action("Index", "Seguindo")"><i class="fas fa-users"></i> Seguindo</a></li>
                    <li><a href="@Url.Action("Index", "Perfil")"><i class="fas fa-user"></i> Perfil</a></li>
                    <li><a href="@Url.Action("Index", "Destaques")"><i class="fas fa-film"></i> Filmes em Destaque</a>
                    </li>
                    <li><a href="@Url.Action("AvaliacoesGlobais", "Avaliacoes")" class="active"><i class="fas fa-star"></i>
                            Avaliações</a></li>
                </ul>
            </nav>
        </aside>

        <main class="main-content">
            <div class="reviews-page-container">
                <div class="movie-header-small">
                    <img src="@ViewBag.Poster" alt="Poster" class="header-poster" id="viewReviewsPoster" />
                    <div class="header-info">
                        <h2 id="viewReviewsTitle">@ViewBag.Title</h2>
                        <span class="header-subtitle">Avaliações da Comunidade</span>
                    </div>
                </div>
                <div class="reviews-list">
                    @if (Model == null || !Model.Any())
                    {
                        <p style="color: #ccc; text-align: center;">Nenhuma avaliação encontrada para este filme.</p>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <div class="review-card">
                                <div class="review-header">
                                    <div class="reviewer-info">
                                        <img src="@(item.foto_perfil != null ? $"data:image/*;base64,{item.foto_perfil}" : "/assets/home-images/user.png")" alt="Avatar" class="reviewer-avatar" />

                                        <div class="reviewer-meta">
                                            <span class="reviewer-name">@item.usuario.nome</span>
                                            <a href="/Perfil/Index?user=@item.usuario.id_usuario" class="reviewer-action">Ver perfil</a>
                                        </div>
                                    </div>
                                    
                                    <div class="dataeTipoComentario">
                                    <button class="review-tag">@item.tipo_comentario</button>
                                    <div class="review-date">@item.data_post.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                </div>

                                <div class="review-body-simple">
                                    <div class="review-rating">
                                        @* Se tiver nota no ViewModel, renderize estrelas aqui *@
                                    </div>
                                    <p class="review-text">@item.descricao</p>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

        </main>
    </div>

    <script src="~/js/home/script.js"></script>
     <script>
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const title = urlParams.get('title');
            const poster = urlParams.get('poster');

            if (title) document.getElementById('viewReviewsTitle').textContent = title;
            if (poster) document.getElementById('viewReviewsPoster').src = poster;
        });

        function getStarsHtml(rating) {
            let html = '';
            for (let i = 1; i <= 5; i++) {
                if (i <= rating) {
                    html += '<i class="fas fa-star"></i>';
                } else {
                    html += '<i class="far fa-star"></i>';
                }
            }
            return html;
        }
    </script>
</body>

</html>