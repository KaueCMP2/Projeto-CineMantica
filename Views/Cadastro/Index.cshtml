@{
    ViewData["Title"] = "Cadastro";
    Layout = null;
}


<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro - Filmes</title>
    <link rel="stylesheet" href="~/css/cadastro/cadastro.css">
    <link rel="stylesheet" href="~/css/cadastro/global.css">
    <script defer src="~/js/cadastro/cadastro.js"></script>

</head>

<body>
    <main class="container-cadastro">
        <!-- LADO ESQUERDO -->
        <section class="lado-esquerdo">
            <div class="efeito-mobile">
                <section class="fazer-cadastro">
                    <header class="topo">
                        <h1 class="titulo">Faça seu cadastro</h1>
                        <p class="subtitulo">Avalie filmes, siga pessoas e descubra novas histórias.</p>
                    </header>

                    @if (!string.IsNullOrEmpty(ViewBag.Erro))
                    {
                        <div class="alerta-erro">
                            <p>@ViewBag.Erro</p>
                        </div>
                    }

                    <form class="forms-cadastro" method="post" action="@Url.Action("Criar", "Cadastro")">
                        <label for="nome">Nome completo</label>
                        <input type="text" id="nome" name="nome" placeholder="Digite seu nome completo" required>

                        <div class="half-input">
                            <div class="half-input-box">
                                <label for="nick_name">Nome de usuário</label>
                                <input type="text" id="nick_name" name="nick_name" placeholder="Digite o usuário" required>
                            </div>
                            <div class="half-input-box">
                                <label for="data_nascimento">Data de nascimento</label>
                                <input type="date" id="data_nascimento" name="data_nascimento" required>
                            </div>
                        </div>

                        <label for="email">E-mail</label>
                        <input type="email" id="email" name="email" placeholder="Digite seu e-mail" required>

                        <div class="half-input">
                            <div class="half-input-box">
                                <label for="senha">Senha</label>
                                <div class="campo-senha">
                                    <input type="password" id="senha" name="senha" placeholder="Digite sua senha" required>
                                    <img class="icone-olho" src="~/assets/Cadastro-images/icons/eye.svg" alt="Mostrar senha" id="iconeOlho" onclick="OcultarSenha()">
                                    <img class="icone-olho-slash" src="~/assets/Cadastro-images/icons/eye-slash.svg" alt="Ocultar senha" id="iconeOlhoSlash" style="display:none;" onclick="OcultarSenha()">
                                </div>
                            </div>

                            <div class="half-input-box">
                                <label for="confirmar">Confirmar senha</label>
                                <div class="campo-senha">
                                    <input type="password" id="confirmar" name="confirmar" placeholder="Digite sua senha novamente" required>
                                    <img class="icone-olho-confirm" src="~/assets/Cadastro-images/icons/eye.svg" alt="Mostrar senha" id="iconeOlhoConfirm" onclick="OcultarSenhaConfirm()">
                                    <img class="icone-olho-slash-confirm" src="~/assets/Cadastro-images/icons/eye-slash.svg" alt="Mostrar senha" id="iconeOlhoSlashConfirm" style="display:none;" onclick="OcultarSenhaConfirm()">
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="botao-registrar">Registrar</button>

                        <p class="possui-conta">Já tem uma conta? <span class="fazer-login"><a href="@Url.Action("Index", "Home")">Faça login</a></span></p>
                    </form>
                </section>
            </div>
        </section>

       
    </main>

    <script src="~/cadastro.js"></script>
</body>

</html>