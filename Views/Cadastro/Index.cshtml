@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/cadastro/cadastro.css">
    <link rel="stylesheet" href="~/css/cadastro/global.css">
    <script defer src="~/js/cadastro/cadastro.js"></script>

</head>

<body>
    <main class="container-cadastro">

        <!-- LADO ESQUERDO -->
        <section class="lado-esquerdo">
            <div class="efeitoMobile">

                <div class="fazerCadastro">
                    <header class="topo">
                        <h1 class="titulo">Faça seu cadastro</h1>
                        <p class="subtitulo">Avalie filmes, siga pessoas e descubra novas histórias.</p>
                    </header>

                    @* FORMULÁRIOS *@
                    <form class="forms-cadastro" asp-action="Criar" asp-controller="Cadastro" method="post">
                        <label for="nome">Nome completo</label>
                        <input type="text" id="nome" name="nome" placeholder="Digite seu nome completo" required>

                        <div class="halfInput">

                            <div class="halfInputBox">
                                <label for="nickname">Nome de usuário</label>
                                <input type="text" id="nickname" name="nickname" placeholder="Digite o usuário"
                                    required>
                            </div>
                            <div class="halfInputBox">
                                <label for="dataNascimento">Data de nascimento</label>
                                <input type="date" id="dataNascimento" name="dataNascimento"
                                    placeholder="Digite a data de nascimento" required>
                            </div>
                        </div>

                        <label for="email">E-mail</label>
                        <input type="email" id="email" name="email" placeholder="Digite seu e-mail" required>

                        <div class="halfInput">

                            <div class="halfInputBox">
                                <label for="senha">Senha</label>
                                <div class="campo-senha">
                                    <input type="password" id="senha" name="senha" placeholder="Digite sua senha"
                                        required>
                                    <img class="iconeOlho" src="~/assets/Cadastro-images/icons/eye.svg" alt=""
                                        id="iconeOlho" onclick="OcultarSenha()">
                                    <img class="iconeOlhoSlash" src="~/assets/Cadastro-images/icons/eye-slash.svg"
                                        alt="" id="iconeOlhoSlash" onclick="OcultarSenha(); return false">
                                </div>
                            </div>

                            <div class="halfInputBox">
                                <label for="confirmarSenha">Confirmar senha</label>
                                <div class="campo-senha">
                                    <input type="password" id="confirmarSenha" name="confirmarSenha"
                                        placeholder="Digite sua senha" required>
                                    <img class="iconeOlhoConfirm" src="~/assets/Cadastro-images/icons/eye.svg" alt=""
                                        id="iconeOlhoConfirm" onclick="OcultarSenhaConfirm()">
                                    <img class="iconeOlhoSlashConfirm"
                                        src="~/assets/Cadastro-images/icons/eye-slash.svg" alt=""
                                        id="iconeOlhoSlashConfirm" onclick="OcultarSenhaConfirm(); return false">
                                </div>
                            </div>
                        </div>

                        @if (ViewBag.Erro != null)
                        {
                            <p class="erro-login mostrar">@ViewBag.Erro</p>
                        }
                        
                        <button type="submit" class="botao-registrar">Registrar</button>

                        <p class="possui-conta">Já tem uma conta? <span class="fazer-login"><a href="/Login/Index">Faça
                                    login</a></span>
                        </p>

                        <div class="botoes-sociais">
                            <a href="#" class="google">
                                <img src="~/assets/Cadastro-images/icons/botao-google.svg" alt="Botão de link do google" class="google">
                            </a>
                            <a href="#" class="facebook">
                                <img src="~/assets/Cadastro-images/icons/botao-face.svg" alt="Botão de link do facebook" class="facebook">
                            </a>
                        </div>


                    </form>
                </div>
            </div>
        </section>

        <!-- LADO DIREITO -->
        <aside class="lado-direito">
            <div class="efeito">

                <div class="container-logo">
                    <img src="~/assets/Cadastro-images/images/logo.png" alt="Logotipo" class="logo">
                </div>
            </div>
        </aside>

    </main>

</body>

</html>