@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cinemantica - Home</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/home.css">
    <script src="~/js/home/scriptcarrossel.js"></script>
</head>

<body>
    <script>
        // Sincronização de Sessão do Servidor com LocalStorage do Cliente
        const serverLoggedIn = "@(Context.Session.GetString("UsuarioId") != null ? "true" : "false")";
        const serverUser = "@Context.Session.GetString("UsuarioNome")";

        if (serverLoggedIn === "true") {
            localStorage.setItem('isLoggedIn', 'true');
            if(serverUser) localStorage.setItem('currentUser', serverUser);
        } else {
            localStorage.removeItem('isLoggedIn');
            localStorage.removeItem('currentUser');
        }
    </script>
    <header class="main-header">
        <button class="hamburger active-button"></button>
        <a href="#" class="barra-topo">
            <img src="~/assets/Cadastro-images/logo.png" alt="Logotipo Cinemantica" class="logo">
        </a>
        <nav class="main-nav">
            <div class="acoes-header">
                <div class="barra-pesquisa">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" placeholder="Busque aqui...">
                </div>
                <div class="acoes-usuario">
                    <div class="notificacao-usuario">
                        <i class="fas fa-bell action-icon"></i>
                        <div class="notification-dot"></div>
                    </div>
                    <div class="user-profile-container">
                        <div class="icone-usuario" id="user-icon">
                            <i class="fas fa-user profile-icon"></i>
                        </div>
                        <div class="user-dropdown" id="user-dropdown">
                            <a href="Views/Login/Index.cshtml">Fazer login</a>
                            <a href="Views/Cadastro/Index.cshtml">Criar conta</a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="content-wrapper">
        <aside class="sidebar">
            <nav class="sidebar-nav">
                <ul>
                    <li>
                        <a asp-controller="Home" asp-action="Index" class="active">
                            <i class="fas fa-home"></i> Home
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Seguindo" asp-action="Index">
                            <i class="fas fa-users"></i> Seguindo
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Perfil" asp-action="Index">
                            <i class="fas fa-user"></i> Perfil
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Destaques" asp-action="Index">
                            <i class="fas fa-film"></i> Filmes em Destaque
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Avaliacoes" asp-action="Feed"> <i class="fas fa-star"></i> Avaliações
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="following-section">
                <div class="following-header">
                    <h3>Seguindo</h3>
                    <span>Assistidos</span>
                </div>
                <ul class="following-list">

                    <li style="padding: 10px; color: #aaa;">Carregando...</li>
                </ul>
                <button class="see-more-btn">
                    <i class="fas fa-chevron-down"></i> Ver mais
                </button>
            </div>
        </aside>

        <main class="main-content">
            <section class="main-banner">
                <div class="background-carousel">
                </div>

                <div class="conteudo-banner">
                    <h1 class="titulo-banner">CINEMANTICA</h1>
                    <p class="subtitulo-banner">Sua rede social para avaliar e comentar filmes. Siga pessoas, curta
                        opiniões e compartilhe o que você achou!</p>
                </div>
            </section>

            <section class="movie-carousel">
                <h2 class="section-title">Em destaque</h2>
                <div class="carousel-content-wrapper">
                    <button class="carousel-arrow prev"><i class="fas fa-chevron-left"></i></button>
                    <div class="carousel-container" id="featured-carousel">

                    </div>
                    <button class="carousel-arrow next"><i class="fas fa-chevron-right"></i></button>
                </div>
            </section>

            <section class="movie-grid">
                <h2 class="section-title">Filmes Bombando</h2>
                <div class="grid-container" id="trending-grid">

                </div>
            </section>

        </main>
    </div>

    </div>

    <div id="reviewModal" class="modal-overlay">
        <div class="modal-content">
            <button class="modal-close-btn" id="closeModalBtn">&times;</button>
            <div class="modal-left">
                <h2 class="modal-movie-title" id="modalMovieTitle">Título do Filme</h2>
                <p class="modal-description" id="modalMovieOverview">Sinopse do filme...</p>

                <div class="modal-ratings">
                    <div class="rating-box">
                        <span class="rating-label">Geral</span>
                        <div class="rating-value" id="modalMovieRating">

                        </div>
                    </div>
                    <div class="rating-box">
                        <span class="rating-label">Amigos</span>
                        <div class="rating-value" id="modalFriendsRating">
                            0 <i class="far fa-star" style="color: red;"></i>
                        </div>
                    </div>
                </div>

                <div class="modal-actions">
                    <button class="modal-btn">Fazer nova Avaliação</button>
                    <button class="modal-btn">Ver Avaliações</button>
                </div>
            </div>
            <div class="modal-right">
                <img src="" alt="Poster do Filme" class="modal-poster" id="modalMoviePoster">
            </div>
        </div>
    </div>

    <script src="~/js/home/script.js"></script>

</body>

</html>