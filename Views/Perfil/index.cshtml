@model ProjetoCinemanticaMVC.Models.PerfilViewModel
@{
    Layout = null;
    var fotoUsuario = Context.Session.GetString("UsuarioFoto");
}
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cinemantica - Perfil</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/home.css">
</head>

<body>
    <script>
        const serverLoggedIn = "@(Context.Session.GetString("UsuarioId") != null ? "true" : "false")";
        const serverUser = "@Context.Session.GetString("UsuarioNome")";

        if (serverLoggedIn === "true") {
            localStorage.setItem('isLoggedIn', 'true');
            if (serverUser) localStorage.setItem('currentUser', serverUser);
        } else {
            localStorage.removeItem('isLoggedIn');
            localStorage.removeItem('currentUser');
        }
    </script>
    <header class="main-header">
        <button class="hamburger active-button"></button>
        <a asp-controller="Home" asp-action="Index" class="barra-topo">
            <img src="~/assets/Cadastro-images/images/logo.png" alt="Logotipo Cinemantica" class="logo">
        </a>
        <nav class="main-nav">
            <div class="acoes-header">
                <div class="barra-pesquisa">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" placeholder="Busque aqui...">
                </div>
                <div class="acoes-usuario">

                    <div class="notificacao-usuario">
                        <i class="fas fa-bell action-icon"></i>
                        <div class="notification-dot"></div>
                    </div>
                    <div class="user-profile-container">
                        <div class="icone-usuario" id="user-icon">
                            <img src="@(string.IsNullOrEmpty(fotoUsuario) 
                                                                 ? "/assets/home-images/user.png" 
                                                                 : $"data:image/*;base64,{fotoUsuario}")" alt="Foto de Perfil" class="profile-avatar-large">
                        </div>
                    </div>
                    <div class="user-dropdown" id="user-dropdown">
                        <a asp-controller="Login" asp-action="Index">Fazer login</a>
                        <a asp-controller="Cadastro" asp-action="Index">Criar conta</a>
                    </div>
                </div>
            </div>
            </div>
        </nav>
    </header>

    <div class="content-wrapper">
        <aside class="sidebar">
            <nav class="sidebar-nav">
                <ul>
                    <li><a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Home</a></li>
                    <li><a asp-controller="Seguindo" asp-action="Index"><i class="fas fa-users"></i> Seguindo</a></li>
                    <li><a asp-controller="Perfil" asp-action="Index" class="active"><i class="fas fa-user"></i>
                            Perfil</a></li>
                    <li><a asp-controller="Destaques" asp-action="Index"><i class="fas fa-film"></i> Filmes em
                            Destaque</a>
                    </li>
                    <li>
                        <a asp-controller="Avaliacoes" asp-action="AvaliacoesGlobais"> <i class="fas fa-star"></i>
                            Avaliações
                        </a>
                    </li>
                </ul>
            </nav>
            @* <div class="following-section">
                <div class="following-header">
                    <h3>Seguindo</h3>
                    <span>Assistidos</span>
                </div>
                <ul class="following-list">
                    <!-- Dynamic List -->
                    <li style="padding: 10px; color: #aaa;">Carregando...</li>
                </ul>
                <button class="see-more-btn">
                    <i class="fas fa-chevron-down"></i> Ver mais
                </button>
            </div> *@
        </aside>

        <main class="main-content">
            <div class="profile-content-wrapper" style="visibility"> <!-- Hidden initially to prevent flash -->
                <div class="profile-header-container">
                    <div class="profile-banner">
                        <img src="@(Model.Perfil.BannerBase64 != null ? $"data:image/*;base64,{Model.Perfil.BannerBase64}" : "/assets/home-images/banner.jpg")"
                            alt="Imagem de Capa do Perfil" class="profile-banner-image">
                    </div>
                    <div class="profile-info-bar">
                        <div class="profile-avatar-wrapper">
                            <img src="@(Model.Perfil.FotoBase64 != null ? $"data:image/*;base64,{Model.Perfil.FotoBase64}" : "/assets/home-images/user.png")"
                                alt="Foto de Perfil" class="profile-avatar-large-perfil">
                            @* <img src="@(Model.Perfil.FotoBase64 != null ? $"data:image/*;base64,{Model.Perfil.FotoBase64}" : "/assets/img/img-perfil.png")"
                                alt="Foto de Perfil" class="profile-avatar-large"> *@
                        </div>
                        <div class="profile-details">
                            <h2 class="profile-username">@Model.Perfil.NomeUsuario</h2>
                            <div class="profile-stats">
                                <div class="stat-item">
                                    <span class="stat-value">@Model.Perfil.seguidores_count</span>
                                    <span class="stat-label">Seguidores</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-value">@Model.Perfil.seguindo_count</span>
                                    <span class="stat-label">Seguindo</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-value">0</span>
                                    <span class="stat-label">Avaliações</span>
                                </div>
                            </div>

                        </div>
                        <p name="desc_perfil" class="stat-label">@Model.Perfil.desc_perfil</p>
                        @if (Model.isMeuPerfil)
                        {
                            <button class="edit-profile-btn">
                                <i class="fas fa-pen"></i> Editar Perfil
                            </button>
                        }
                        else
                        {
                            <form asp-controller="Perfil" asp-action="ToggleFollow" method="post">
                                <input type="hidden" name="seguindoId" value="@Model.Perfil.id_usuario" />

                                @if (Model.JaSegue)
                                {
                                    <button type="submit" class="btn-unfollow follow-profile-btn">
                                        <i class="fas fa-user-minus"></i> Deixar de seguir
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn-follow follow-profile-btn">
                                        <i class="fas fa-user-plus"></i> Seguir
                                    </button>
                                }
                            </form>
                        }
                    </div>
                </div>

                <section style="padding: 20px;" class="reviews-section">
                    <h2 class="section-title">Avaliações</h2>
                    @foreach (var review in Model.Avaliacoes)
                    {
                        <article style="padding: 16px; margin-bottom: 30px" class="review-card">
                            @* <div class="review-header">
                                <div class="reviewer-info"> *@
                            @* <img src="https://image.tmdb.org/t/p/w500/@review.PosterFilme" alt="Avatar"
                                    class="reviewer-avatar"> *@
                            @* <div class="reviewer-meta">
                                    <span class="reviewer-name">@review.</span>
                                    <span class="reviewer-action">Ver perfil</span>
                                </div> *@
                            @* </div>
                                
                            </div> *@
                            <div class="review-body">
                                <img src="https://image.tmdb.org/t/p/w500/@review.PosterFilme" alt="Poster do Filme"
                                    class="review-movie-poster">
                                <div class="review-content">
                                    <h3 class="review-movie-title">@review.TituloFilme</h3>
                                    <div class="review-rating">
                                        ${getStarsHtml(review.rating)}
                                    </div>
                                    <p class="review-text">@review.descricao</p>
                                </div>
                                <div style="display: flex; align-items: center;">
                                    <button class="review-tag">@review.tipo_comentario</button>
                                </div>
                            </div>
                        </article>


                    }
                </section>
            </div>

            <div class="login-overlay" id="login-overlay">
                <h2>Acesso Restrito</h2>
                <p>Faça login para visualizar seu perfil, editar informações e gerenciar suas avaliações.</p>
                <a asp-controller="Login" asp-action="Index" class="login-btn-overlay">Fazer Login</a>
            </div>
        </main>
    </div>

    <!-- Edit Profile Modal -->
    <div class="modal-overlay" id="edit-profile-modal">
        <div class="edit-profile-modal">

            <h2 class="section-title" style="margin-bottom: 20px;">Editar Perfil</h2>
            <form method="post" action="/Perfil/AtualizarFoto" enctype="multipart/form-data" class="edit-profile-form"
                id="edit-profile-form">
                <input type="hidden" name="id_usuario" value="@Model.Perfil.id_usuario" />

                <div class="form-group">
                    <label for="display-name">Nome de Exibição</label>
                    <input name="nome" type="text" id="display-name" placeholder="Seu nome"
                        value="@Model.Perfil.NomeUsuario">
                </div>
                <div class="form-group">
                    <label for="display-name">Descrição do perfil</label>
                    <input maxlength="100" name="desc_perfil" type="text" id="display-name" placeholder="Descrição..."
                        value="@Model.Perfil.desc_perfil">
                </div>
                <div class="form-group">
                    <input type="file" id="upload-foto" name="foto" class="input-arquivo" accept="image/*">
                    <label for="avatar-url">URL da Foto de Perfil</label>
                </div>
                <div class="form-group">
                    <input type="file" id="upload-foto" name="banner" class="input-arquivo" accept="image/*">
                    <label for="banner-url">URL da Imagem de Capa</label>
                </div>
                <div class="modal-actions-row">
                    <button type="button" class="btn-cancel" id="cancel-edit-profile">Cancelar</button>
                    <button type="submit" class="btn-save">Salvar</button>
                </div>
            </form>
        </div>
    </div>
    <script src="~/js/home/script.js"></script>
    <script src="~/js/perfil/perfil.js"></script>
</body>

</html>